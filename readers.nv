class Csv
	int fd, col, carry_over
	char[16416] buf # Padded slightly to avoid SIMD segfaults
	i64 bytes_read
	str cur_buffer, fname
	array<str> header
	array<array<str>> elem
	map<str, int> col_to_id
	char sep

	ctor(str fname, char sep)
		self.fd = c_open(fname)
		self.col = 0
		self.carry_over = 0
		self.bytes_read = -1
		self.fname = fname
		self.sep = sep

		self.read()
		
	def i64 get_buff()
		i64 newly_read = c_read(
						self.fd, self.buf offby self.carry_over, 16384 - self.carry_over
					)
		
		self.bytes_read = newly_read + self.carry_over
		
		if self.bytes_read == 0
			return 0

		str buffer = c_malloc_str(self.bytes_read)
		c_memcpy(
			buffer, self.buf,
			self.bytes_read
		)
		self.cur_buffer = buffer
		return newly_read
		

	def float read()

		while true
			i64 newly_read = self.get_buff()
			
			if self.bytes_read == 0
				break

			int mask = 0, pos = 0, last_pos = 0
			
			# SIMD path for >= 32 bytes
			while pos + 32 <= self.bytes_read
				vec<i8,32> bytes = simd_load(self.buf offby pos, i8, 32)
				vec<i8,32> v_comma = vec_make(self.sep, 32)
				vec<i8,32> v_break = vec_make('\n', 32)

				vec<i8,32> v_mask = (v_comma==bytes) or (v_break==bytes)
				mask = v_mask.movemask()
				
				if mask==0
					pos = pos + 32
					continue

				int offset = pos
				while mask!=0
					int idx = ctz(mask)
					pos = offset + idx

					self.process_delimiter(last_pos, pos, pos-last_pos)

					last_pos = pos + 1
					mask = swap_bit(mask, idx)
				
				pos = offset + 32

			# If file ended, manually parse the final <32 bytes
			if newly_read == 0
				while last_pos < self.bytes_read
					int next_pos = last_pos
					
					# Scan forward for the next delimiter
					while next_pos < self.bytes_read
						char c = self.buf[next_pos]
						if c == self.sep or c == '\n'
							break
						next_pos = next_pos + 1
					
					self.process_delimiter(last_pos, next_pos, next_pos - last_pos)
					last_pos = next_pos + 1
				break

			# Carry over unprocessed bytes at the chunk boundary
			self.carry_over = self.bytes_read - last_pos
			if self.carry_over > 0
				for i=0, i<self.carry_over
					self.buf[i] = self.buf[last_pos + i]

	def float process_delimiter(
				int offset,
				int pos,
				int size
			)
			
		char delimiter = '\n'
		if pos < self.bytes_read
			delimiter = self.buf[pos]

		if size == 0 and delimiter != '\n'
			return 0
			
		if size == 0 and delimiter == '\n'
			self.col = 0
			return 0

		str _view = {self.cur_buffer offby offset, size}
		if self.elem.size()<=self.col
			array<str> new_col
			self.elem.append(new_col)
			self.header.append(_view)
			self.col_to_id[_view] = self.col
		else
			self.elem[self.col].append(_view)

		self.col = self.col + 1
		if delimiter=='\n'
			self.col = 0

	def array<str> get_cols()
		return self.header

	def array<str> get_col(str col_name)
		return self.elem[self.col_to_id[col_name]]
